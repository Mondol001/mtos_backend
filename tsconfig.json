{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "server.ts",
    "server/**/*.ts",
    "src/types.ts",
    "src/utils/landRecords.ts",
    "src/utils/billing.ts"
  ]
}
